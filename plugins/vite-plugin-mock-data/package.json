  "dependencies": {
    "find-my-way": "^9.2.0",
    "is-what-type": "^1.1.4",
    "sirv": "^3.0.1",
    "tinyglobby": "^0.2.12",
    "vp-runtime-helper": "workspace:^"
  },
  "devDependencies": {
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-external": "workspace:^"
  },
  "files": [
    "dist"
  ]
