{
  "name": "vite-plugin-mock-data",
  "version": "8.2.0",
  "description": "Mocks API routes on the Vite dev server from a mock directory or inline route config, and can expose file-based routes to the browser for built static pages.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./axios-adapter": {
      "types": "./dist/axios-adapter.d.ts",
      "import": "./dist/axios-adapter.js"
    },
    "./mock-client": {
      "types": "./dist/mock-client.d.ts",
      "import": "./dist/mock-client.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "vite": ">=8.0.0"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "prepublishOnly": "npm run build",
    "release": "pnpm publish --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengxinming/vite-plugins.git",
    "directory": "plugins/vite-plugin-mock-data"
  },
  "keywords": [
    "vite-plugin",
    "vite-plugin-mock-data"
  ],
  "author": "Jesse Feng <fxm0016@126.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fengxinming/vite-plugins/issues"
  },
  "homepage": "https://fengxinming.github.io/vite-plugins/plugins/vite-plugin-mock-data/quick-start",
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "@rolldown/pluginutils": "^1.0.1",
    "fastify": "^5.12.1",
    "is-what-type": "^1.1.4",
    "path-to-regexp": "^8.2.0",
    "tinyglobby": "^0.2.12",
    "vp-runtime-helper": "workspace:^"
  },
  "peerDependencies": {
    "axios": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "axios": "^1.7.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-external": "workspace:^"
  },
  "files": [
    "dist"
  ]
}
